#!/usr/bin/env python
'''
first argument should be the config you're wishing to extract info from
'''
import os
import sys

from pathlib import Path

from contextlib import redirect_stdout
from typing import List, Dict
from omegaconf import OmegaConf
from datetime import datetime

# add prod directory to path
PROD_DIR = str(os.environ['PROD_DIR'])
sys.path.append(os.path.expanduser(PROD_DIR))

from core.config_io import extract_globals
from core.io        import print_cfg



def runner(config_path : str) -> None: 
    '''
    takes the provided config file and interprets it, then passes off the resulting work
    to the relevant functions


    will be:
    - city/pack
      - runs of relevance
      - io
      - parameters
    iteratively for each.
    '''
    
    # load config
    cfg = OmegaConf.load(config_path)

    # extract globals
    global_vars = extract_globals(cfg)
    # create timestamp
    now = datetime.now()
    global_vars['timestamp'] = now.strftime('%y%m%d_%H%M')


    tag_path = f"{PROD_DIR}/tags/{global_vars['tag']}" 
    # extract tag, check it doesnt exist already
    if Path(tag_path).exists():
        raise FileExistsError(f"{global_vars['tag']} already exists! Select another.")


    # make config directory
    full_config_path = os.path.join(global_vars['global_path'], global_vars['config_location'])
    Path(full_config_path).mkdir(parents = True, exist_ok = True)
    global_vars['config_path'] = full_config_path


   # write this config setup to a tag, tags must be altered
    with open(f'{tag_path}.tag', 'w') as f:
        with redirect_stdout(f):
            print_cfg(global_vars)
            print_cfg(cfg, indent = 4)


    # print configuration
    print_cfg(global_vars)
    print_cfg(cfg, indent = 4)
        

    for executables, config_dict in cfg.items():

        # IC executable or otherwise
        if executables[:2] == 'IC':
            process_IC(global_vars, config_dict, executables)
        else:
            process_binary(global_vars, config_dict, executables)

if __name__ == '__main__':
    
    config_path = sys.argv[1]
    runner(config_path)
