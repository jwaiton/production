#!/usr/bin/env python
'''
first argument should be the config you're wishing to extract info from
'''
import os
import sys
import logging
import copy

from pathlib import Path
from itertools import product

from contextlib import redirect_stdout
from typing import List, Dict, Generator 
from omegaconf import OmegaConf
from omegaconf import DictConfig
from datetime import datetime

# add prod directory to path
PROD_DIR = str(os.environ['PROD_DIR'])
sys.path.append(os.path.expanduser(PROD_DIR))

from core.config_io  import extract_globals
from core.io         import print_cfg
from core.logging    import setup_logging
import core.processing as proc

def generate_tag(global_vars : Dict,
                 cfg         : DictConfig) -> None:
    '''
    write tag out
    '''

    tag_path = f"{PROD_DIR}/tags/{global_vars['tag']}.tag"
    # extract tag, check it doesnt exist already
    if Path(tag_path).exists():
        logging.error(f"Tag already exists: {global_vars['tag']}")
        raise FileExistsError(f"Tag {global_vars['tag']} already exists! Select another.")


    # write this config setup to a tag, tags must be altered
    with open(f'{tag_path}', 'w') as f:
        with redirect_stdout(f):
            print_cfg(global_vars)
            print_cfg(cfg, indent = 4)



def expand_config(cfg : DictConfig) -> Generator:
    '''
    given the config, generate the pairing of:
        executable, config
    used to run the city
    '''

    for executable, base_cfg in cfg.items():
        yield executable, base_cfg


def expand_sweeps(cfg : DictConfig): 
    '''
    yield executable and config_dict
    where the config_dict includes one sweep combination    
    '''
    for executable, base_cfg in cfg.items():
        sweep = base_cfg.get("sweep", {})
        fixed = base_cfg.get("fixed", {})
    
        # if there is no sweep
        if not sweep:
            cfg_copy = copy.deepcopy(fixed)
            yield executable, cfg_copy
            continue
        
        keys   = list(sweep.keys())
        values = list(sweep.values())

        for combo in product(*values):
            cfg_copy = copy.deepcopy(fixed)
            cfg_copy.update(dict(zip(keys, combo)))
            yield executable, cfg_copy


def iter_execution_units(flow : str,
                         jobs : List,
                         runs : List):
    '''
    create the necessary combinations for execution
    '''
    if flow == "JOB":
        return ((executable, RN, config_dict) for (executable, config_dict), RN in product(jobs, runs))
    elif flow == "RUN":
        return ((executable, RN, config_dict) for RN, (executable, config_dict) in product(run, job))
    else:
        raise ValueError(f"Unknown flow priority: {flow}")

def select_execution_type(name : str,
                          config_dict : DictConfig,
                          global_vars : Dict):
    '''
    decides the execution method, IC or otherwise
    '''
    # IC executable or otherwise
    if name[:2] == 'IC':
        config_dict['city'] = name.split('-')[-1]
        proc.process_IC(global_vars, config_dict, name)
    else:
        proc.process_binary(global_vars, config_dict, name)



def runner(config_path : str) -> None: 
    '''
    takes the provided config file and interprets it, then passes off the resulting work
    to the relevant functions


    will be:
    - city/pack
      - runs of relevance
      - io
      - parameters
    iteratively for each.
    '''
    
    # load config
    cfg = OmegaConf.load(config_path)

    # extract globals
    global_vars = extract_globals(cfg)
    # create timestamp
    now = datetime.now()
    global_vars['timestamp'] = now.strftime('%y%m%d_%H%M')


    logging.info(f"Job loaded, timestamp {global_vars['timestamp']}")

    tag_path = f"{PROD_DIR}/tags/{global_vars['tag']}.tag"
    # extract tag, check it doesnt exist already
    if Path(tag_path).exists():
        logging.error(f"Tag already exists: {global_vars['tag']}")
        raise FileExistsError(f"Tag {global_vars['tag']} already exists! Select another.")

    # currently multiple sweeps across differing cities aren't enabled
    if sum("sweep" in inner for inner in cfg.values()) > 1:
        raise ValueError("Parameter sweeps are only available for one city at a time!")

    # make data storage directory
    full_storage_path = os.path.join(global_vars['global_path'], global_vars['tag'])
     
    full_config_path  = os.path.join(full_storage_path, 'configs')
    Path(full_config_path).mkdir(parents = True, exist_ok = True)
    global_vars['config_path'] = full_config_path

    full_data_path    = os.path.join(full_storage_path, 'data')
    Path(full_data_path).mkdir(parents = True, exist_ok = True)
    global_vars['data_path'] = full_data_path

   # write this config setup to a tag, tags must be altered
    with open(f'{tag_path}', 'w') as f:
        with redirect_stdout(f):
            print_cfg(global_vars)
            print_cfg(cfg, indent = 4)

    # print configuration
    print_cfg(global_vars)
    print_cfg(cfg, indent = 4)
 
    # collect all sweeps
    jobs = list(expand_sweeps(cfg))
    runs = list(global_vars['RUNS'])
    logging.info('Beginning execution...')

    # extract the sweeping parameters explicitly for labelling purposes
    for executable, base_cfg in cfg.items():
        sweep = base_cfg.get("sweep", {})
        if sweep:
            sweep_params = list(sweep.keys())


    for executable, RN, config_dict in iter_execution_units(global_vars['flow_priority'], jobs, runs):
        logging.info(f"{executable} initiated for R{RN}...")
        config_dict["run_number"] = RN
        config_dict['sweep_params'] = sweep_params
        print_cfg(config_dict)
        select_execution_type(executable, config_dict, global_vars)

if __name__ == '__main__':
    
    setup_logging()
    config_path = sys.argv[1]
    runner(config_path)
